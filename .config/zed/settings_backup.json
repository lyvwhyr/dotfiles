// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `zed: Open Default Settings` command
// from the command palette
{
  "ssh_connections": [
    {
      "host": "54.157.226.75",
      "username": "ubuntu",
      "projects": [
        {
          "paths": [
            "/home/ubuntu/ehrmai"
          ]
        },
        {
          "paths": [
            "/home/ubuntu/ehrmai/backend"
          ]
        },
        {
          "paths": [
            "/home/ubuntu/ehrmai/ehrmai"
          ]
        },
        {
          "paths": [
            "/home/ubuntu/ehrmai/frontend"
          ]
        },
        {
          "paths": [
            "/home/ubuntu/ehrmai/quartermaster"
          ]
        }
      ],
      "nickname": "ehrm med EC2  Ubuntu"
    }
  ],
  "restore_on_startup": "last_workspace",
  "cursor_shape": "bar",
  "edit_predictions": {
    "disabled_globs": [],
    "mode": "eager",
    "copilot": {
      "proxy": null,
      "proxy_no_verify": null
    },
    "enabled_in_text_threads": false
  },
  "show_whites paces": "all",
  "agent": {
    "default_profile": "write",
    "always_allow_tool_actions": true,
    "profiles": {
      "write": {
        "name": "Write",
        "tools": {
          "open": true,
          "copy_path": true,
          "create_directory": true,
          "create_file": true,
          "delete_path": true,
          "diagnostics": true,
          "edit_file": true,
          "fetch": true,
          "list_directory": true,
          "move_path": true,
          "now": true,
          "find_path": true,
          "read_file": true,
          "grep": true,
          "terminal": true,
          "thinking": true,
          "web_search": true
        },
        "enable_all_context_servers": true,
        "context_servers": {}
      }
    },
    "default_model": {
      "provider": "google",
      "model": "gemini-2.0-flash"
    },
    "version": "2"
  },
  "language_models": {
    "ollama": {
      "api_url": "http://192.168.0.150:11434",
      "available_models": [
        {
          "name": "qwen2.5-coder:7b",
          "display_name": "qwen 2.5 coder 32K",
          "max_tokens": 32768
        },
        {
          "name": "llama4:latest",
          "display_name": "Llama 4 8B",
          "description": "Llama 4 is Meta's latest open-source large language model, excelling in various NLP tasks.",
          "max_tokens": 8192
        },
        {
          "name": "gemma3:4b",
          "display_name": "Gemma 3 4B",
          "description": "Gemma 3 is a family of open models from Google, known for their strong performance and efficiency.",
          "max_tokens": 8192
        },
        {
          "name": "mistral-nemo",
          "display_name": "Mistral NEMO",
          "description": "A Mistral model optimized for coding tasks.",
          "max_tokens": 32768
        },
        {
          "name": "reader-lm",
          "display_name": "Reader LM",
          "description": "Reader LM, designed for processing and understanding text, is well-suited for tasks involving summarization and question answering.",
          "max_tokens": 8192
        }
      ]
    }
  },

  "scrollbar": {
    "show": "auto"
  },
  // Indentation, rainbow indentation
  "indent_guides": {
    "enabled": true,
    "coloring": "indent_aware"
  },
  // NOTE: Zen mode, refer https://github.com/zed-industries/zed/issues/4382 when it's resolved
  "centered_layout": {
    "left_padding": 0.15,
    "right_padding": 0.15
  },
  "autosave": "on_focus_change",
  "autosave_after_delay": 5000,
  // Code completion settings
  "features": {
    "edit_prediction_provider": "supermaven"
  },
  // Text wrapping settings
  "wrap_guides": [80, 120],
  "format_on_save": "on",
  "ui_font_size": 13,
  "buffer_font_size": 13.0,
  // "buffer_font_family": "IBM Plex Mono",
  "theme": {
    "mode": "dark",
    "light": "KTRZ Monokai",
    "dark": "Gruvbox Dark Hard"
  },
  "languages": {
    // Refer https://zed.dev/docs/languages/javascript and https://zed.dev/docs/languages/typescript for more info
    "TypeScript": {
      // Refer https://github.com/jellydn/ts-inlay-hints for how to setup for Neovim and VSCode
      "inlay_hints": {
        "enabled": true,
        "show_parameter_hints": false,
        "show_other_hints": true,
        "show_type_hints": true
      }
    },
    "Python": {
      "language_servers": ["pyright", "ruff"],
      "format_on_save": "on",
      "formatter": [
        {
          "code_actions": {
            "source.organizeImports.ruff": true,
            "source.fixAll.ruff": true
          }
        },
        {
          "language_server": {
            "name": "ruff"
          }
        }
      ]
    }
  },
  // Code formatting
  // Python
  "language_overrides": {
    "Python": {
      "language_servers": ["pyright", "ruff"],
      "formatter": [
        {
          "code_actions": {
            "source.fixall.pyright": true,
            // Fix all auto-fixable lint violations
            "source.fixAll.ruff": true,
            // Organize imports
            "source.organizeImports.ruff": true
          }
        }
      ]
    }
  },
  "lsp": {
    "pyright": {
      "settings": {
        "python.analysis.typeCheckingMode": "off"
      },
      "python": {
        "pythonPath": ".venv/bin/python"
      }
    }
  },
  // Use zed commit editor
  "terminal": {
    "env": {
      "EDITOR": "zed --wait"
    }
  },
  // File scan exclusions, hide on the file explorer and search
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    // above is default from Zed
    "**/out",
    "**/dist",
    "**/.husky",
    "**/.turbo",
    "**/.vscode-test",
    "**/.vscode",
    "**/.next",
    "**/.storybook",
    "**/.tap",
    "**/.nyc_output",
    "**/node_modules",
    "**__pycache__"
  ],
  // Turn off telemetry
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  }
}
