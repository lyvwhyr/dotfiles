 /* wallust template - colors-rofi */

* {
active-background: #409B89;
active-foreground: #FBF3E9;
normal-background: #000008;
normal-foreground: #FBF3E9;
urgent-background: #00C9B1;
urgent-foreground: #FBF3E9;

alternate-active-background: #FF1011;
alternate-active-foreground: #FBF3E9;
alternate-normal-background: #000008;
alternate-normal-foreground: #FBF3E9;
alternate-urgent-background: #000008;
alternate-urgent-foreground: #FBF3E9;

selected-active-background: #00C9B1;
selected-active-foreground: #FBF3E9;
selected-normal-background: #00C9B1;
selected-normal-foreground: #FBF3E9;
selected-urgent-background: #409B89;
