background-color: #000008;
background: rgba(0,0,0,0.7);
foreground: #FBF3E9;
border-color: #409B89;

color0: #101116;
color1: #545A50;
color2: #B31514;
color3: #BF0C0D;
color4: #307467;
color5: #009785;
